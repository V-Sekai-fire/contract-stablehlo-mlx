import LeanSlang
import StablehloMlx.Kernels.Shaders

/-!
# `emit_kernels` — Lean kernels → Slang → Metal, for `mx::fast::metal_kernel`

    lake exe emit_kernels [slangc]

For each kernel in `StablehloMlx.Kernels.Shaders.all`: write the Slang
(`kernels/slang/<k>.slang`), compile it with `slangc -target metal`
(`kernels/metal/<k>.metal`), and split the Metal into what
`metal_kernel` takes: a header (the helper functions), a body (the entry
point's statements) and the input and output buffer names. The result is
`StablehloMlx/Kernels/Metal.lean`, which the executor loads, and which pins the
Slang it came from (`StablehloMlx/Kernels/Pins.lean` checks that pin against the
Lean kernels with `native_decide`).
-/

open LeanSlang
open StablehloMlx.Kernels

/-- `metal_kernel` writes the entry signature itself, with the inputs `const`;
    slangc's body stores the buffer pointers into a context struct whose fields
    are not `const`, so each such store gets a cast to the field's type. -/
def fixContextLine (l : String) : String :=
  let t := l.trimAscii.toString
  if t.startsWith "(&kernelContext_" && (t.splitOn ")->").length > 1 then
    match t.splitOn " = " with
    | [lhs, rhs] =>
        let r := (rhs.dropEnd 1).toString
        "    " ++ lhs ++ " = (decltype(" ++ lhs ++ "))(" ++ r ++ ");"
    | _ => l
  else l

structure Split where
  header : String
  body : String
  inputs : Array String
  outputs : Array String

/-- The slangc name of global `g` among the entry's parameters (`g_<n>`). -/
def paramName (params : List String) (g : String) : Option String :=
  params.find? fun p =>
    p.startsWith (g ++ "_") && ((p.drop (g.length + 1)).all Char.isDigit)

def splitMetal (m : SlangShaderModule) (metal : String) : Except String Split := do
  let lines := metal.splitOn "\n"
  let some k := lines.findIdx? (·.startsWith "[[kernel]] void main_0(")
    | throw "no [[kernel]] void main_0( line in slangc output"
  let sig := lines[k]!
  let inner := ((sig.splitOn "(").drop 1 |> "(".intercalate).splitOn ")" |>.dropLast |> ")".intercalate
  let names := (inner.splitOn ", ").map fun p =>
    match (p.splitOn " [[").head?.map (·.splitOn " ") with
    | some ws => ws.getLast?.getD ""
    | none => ""
  let mut ins := #[]
  let mut outs := #[]
  for g in m.globals do
    let some n := paramName names g.name | throw s!"global {g.name} is not an entry parameter"
    match g.type with
    | .roBuf _ => ins := ins.push n
    | .rwBuf _ => outs := outs.push n
    | _ => throw s!"global {g.name}: only buffers are carried"
  let some tidName := paramName names "tid" | throw "no tid parameter"
  let keep (l : String) := !(l.trimAscii.toString.startsWith "#line")
  let header := (lines.take k).filter keep
  let rest := lines.drop (k + 1)
  -- rest = "{" :: statements ++ ["}"] (slangc puts each brace on its own line).
  let stmts := ((rest.drop 1).reverse.dropWhile (fun l => l.trimAscii.toString != "}")).drop 1 |>.reverse
  let body := ("    uint3 " ++ tidName ++ " = thread_position_in_grid;") ::
    (stmts.filter keep).map fixContextLine
  -- No implicit contraction: a separate product and sum stay two roundings, as
  -- in ggml-cpu; every fused multiply-add in the kernels is an explicit fma().
  let header := "#pragma METAL fp contract(off)" :: header
  return { header := "\n".intercalate header, body := "\n".intercalate body, inputs := ins, outputs := outs }

def leanStr (s : String) : String := s.quote

def main (args : List String) : IO UInt32 := do
  let slangc := args.headD "slangc"
  IO.FS.createDirAll "kernels/slang"
  IO.FS.createDirAll "kernels/metal"
  let mut out := "-- Generated by `lake exe emit_kernels` from StablehloMlx/Kernels/Shaders.lean. Do not edit.\n" ++
    "-- slangc -target metal; split for mx::fast::metal_kernel.\n" ++
    "import StablehloMlx.Kernels.Spec\n\nnamespace StablehloMlx.Kernels.Metal\n\nopen StablehloMlx.Kernels\n\n"
  let mut table := #[]
  for (name, m) in Shaders.all do
    let slang := emit m
    let sPath := s!"kernels/slang/{name}.slang"
    let mPath := s!"kernels/metal/{name}.metal"
    IO.FS.writeFile sPath (slang ++ "\n")
    -- Relative paths: slangc writes the input path into #line directives.
    let r ← IO.Process.output { cmd := slangc, args := #["-target", "metal", "-stage", "compute", "-entry", "main", "-o", mPath, sPath] }
    if r.exitCode != 0 then
      IO.eprintln s!"slangc failed on {name}:\n{r.stderr}"
      return 1
    let metal ← IO.FS.readFile mPath
    match splitMetal m metal with
    | .error e => IO.eprintln s!"{name}: {e}"; return 1
    | .ok sp =>
      let ident := name.replace "_" ""
      out := out ++ s!"def {ident} : Spec where\n  name := {leanStr name}\n  slang := {leanStr slang}\n" ++
        s!"  inputs := #[{", ".intercalate (sp.inputs.toList.map leanStr)}]\n" ++
        s!"  outputs := #[{", ".intercalate (sp.outputs.toList.map leanStr)}]\n" ++
        s!"  header := {leanStr sp.header}\n  body := {leanStr sp.body}\n\n"
      table := table.push ident
  out := out ++ s!"def all : List Spec := [{", ".intercalate table.toList}]\n\nend StablehloMlx.Kernels.Metal\n"
  IO.FS.writeFile "StablehloMlx/Kernels/Metal.lean" out
  IO.println s!"{table.size} kernels -> StablehloMlx/Kernels/Metal.lean"
  return 0
